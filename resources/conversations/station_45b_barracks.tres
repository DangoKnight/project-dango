[gd_resource type="Resource" script_class="ConversationEvent" load_steps=21 format=3]

[ext_resource type="Script" path="res://scripts/conversation/conversation_event.gd" id="Event"]
[ext_resource type="Script" path="res://scripts/conversation/conversation_line.gd" id="Line"]
[ext_resource type="Resource" path="res://resources/rpg/characters/usami.tres" id="Usami"]
