[resource]
script = ExtResource("Script")
id = &"kurako"
display_name = "Kurako"
title = "The prankster jellyfish"
description = "A mischievous jellyfish who treats danger as an opportunity for a prank. Kurako's stinging tricks leave hostiles weakened, poisoned, or unable to move, and seeing a weakened target really boosts her spirit."
starting_class = ExtResource("Class")
base_stats = SubResource("Base")
stat_growth = SubResource("Growth")
resistances = Array[ExtResource("ResistanceScript")]([SubResource("fireResistance"), SubResource("frostResistance")])
unique_abilities = Array[ExtResource("AbilityScript")]([ExtResource("Unique0"), ExtResource("Unique1"), ExtResource("Unique2")])
allowed_weapon_types = Array[ExtResource("WeaponTypeScript")]([ExtResource("sword"), ExtResource("axe"), ExtResource("spear")])
starting_weapon = ExtResource("StartingWeapon")
critical_rate = 0.05
accuracy = 0.95
portrait = ExtResource("Portrait")
portrait_offset = Vector2(0, 0.3)
portrait_scale = 1.55
combat_texture = ExtResource("Portrait")
hidden_abilities = Array[ExtResource("PassiveScript")]([ExtResource("HiddenPassive")])
