[resource]
script = ExtResource("Script")
id = &"usami"
display_name = "Usami"
title = "The friendly rabbit"
description = "A warm-hearted rabbit girl who keeps the group together when the labyrinth feels endless. Usami lifts spirits with a cheerful word and tends to companions when the journey takes its toll. Seeing everyone safe and healthy puts an extra spring in her step."
starting_class = ExtResource("Class")
base_experience_reward = null
base_stats = SubResource("Base")
stat_growth = SubResource("Growth")
resistances = Array[ExtResource("ResistanceScript")]([SubResource("fireResistance"), SubResource("frostResistance")])
unique_abilities = Array[ExtResource("AbilityScript")]([ExtResource("Unique0"), ExtResource("Unique1")])
hidden_abilities = Array[ExtResource("PassiveScript")]([ExtResource("HiddenPassive")])
allowed_weapon_types = Array[ExtResource("WeaponTypeScript")]([ExtResource("sword"), ExtResource("axe"), ExtResource("spear")])
starting_weapon = ExtResource("StartingWeapon")
critical_rate = 0.05
accuracy = 0.95
