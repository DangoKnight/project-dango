[sub_resource type="Resource" id="Base"]
script = ExtResource("Stats")
max_hp = 5.0
max_mp = 15.0
mental_acuity = 5.0
mental_resilience = 3.0

[sub_resource type="Resource" id="Unlockember"]
script = ExtResource("UnlockScript")
ability = ExtResource("ember")

[sub_resource type="Resource" id="Unlockmend"]
script = ExtResource("UnlockScript")
level = 2
ability = ExtResource("mend")

[sub_resource type="Resource" id="StatusUnlock"]
script = ExtResource("UnlockScript")
level = 3
ability = ExtResource("enfeeble")

[sub_resource type="Resource" id="Resistance"]
script = ExtResource("ResistanceScript")
damage_type = ExtResource("Type")
amount = 0.2

[sub_resource type="Resource" id="Growth"]
script = ExtResource("Stats")
max_hp = 3.0
max_mp = 4.0
strength = 0.5
defense = 0.5
mental_acuity = 2.5
mental_resilience = 1.5
speed = 1.0

[resource]
script = ExtResource("Script")
id = &"arcanist"
display_name = "Arcanist"
base_stats = SubResource("Base")
stat_growth = SubResource("Growth")
resistances = Array[ExtResource("ResistanceScript")]([SubResource("Resistance")])
learned_abilities = Array[ExtResource("UnlockScript")]([SubResource("Unlockember"), SubResource("Unlockmend"), SubResource("StatusUnlock")])
allowed_weapon_types = Array[ExtResource("WeaponTypeScript")]([ExtResource("staff"), ExtResource("wand")])
