[gd_resource type="Resource" load_steps=18 format=3]

[ext_resource type="Script" path="res://scripts/rpg/character_definition.gd" id="Script"]
[ext_resource type="Script" path="res://scripts/rpg/stats.gd" id="Stats"]
[ext_resource type="Script" path="res://scripts/rpg/ability.gd" id="AbilityScript"]
[ext_resource type="Script" path="res://scripts/rpg/damage_resistance.gd" id="ResistanceScript"]
[ext_resource type="Resource" path="res://resources/rpg/classes/arcanist.tres" id="Class"]
[ext_resource type="Resource" path="res://resources/rpg/abilities/starfall.tres" id="Unique"]
[ext_resource type="Resource" path="res://resources/rpg/damage_types/frost.tres" id="frost"]
[ext_resource type="Resource" path="res://resources/rpg/damage_types/fire.tres" id="fire"]

[ext_resource type="Script" path="res://scripts/rpg/weapon_type.gd" id="WeaponTypeScript"]
[ext_resource type="Resource" path="res://resources/rpg/weapon_types/staff.tres" id="staff"]
[ext_resource type="Resource" path="res://resources/rpg/weapon_types/wand.tres" id="wand"]
[ext_resource type="Resource" path="res://resources/rpg/weapon_types/dagger.tres" id="dagger"]
[ext_resource type="Resource" path="res://resources/rpg/weapons/apprentice_staff.tres" id="StartingWeapon"]

[sub_resource type="Resource" id="Base"]
script = ExtResource("Stats")
max_hp = 40.0
max_mp = 20.0
strength = 3.0
defense = 2.0
mental_acuity = 9.0
mental_resilience = 6.0
speed = 8.0
[sub_resource type="Resource" id="Growth"]
script = ExtResource("Stats")
max_hp = 3.0
max_mp = 3.0
strength = 0.5
defense = 0.5
mental_acuity = 2.0
mental_resilience = 1.0
speed = 1.5
[sub_resource type="Resource" id="frostResistance"]
script = ExtResource("ResistanceScript")
damage_type = ExtResource("frost")
amount = 0.25
[sub_resource type="Resource" id="fireResistance"]
script = ExtResource("ResistanceScript")
damage_type = ExtResource("fire")
amount = -0.2


[resource]
script = ExtResource("Script")
id = &"test_caster"
display_name = "Test Caster"
description = "Generic caster used only by automated tests."
starting_class = ExtResource("Class")
base_stats = SubResource("Base")
stat_growth = SubResource("Growth")
unique_abilities = Array[ExtResource("AbilityScript")]([ExtResource("Unique")])
resistances = Array[ExtResource("ResistanceScript")]([SubResource("frostResistance"), SubResource("fireResistance")])

allowed_weapon_types = Array[ExtResource("WeaponTypeScript")]([ExtResource("staff"), ExtResource("wand"), ExtResource("dagger")])
starting_weapon = ExtResource("StartingWeapon")
growth_variation = 0.0
